# Server Configuration
PORT=3000
NODE_ENV=development

# Initial Administrator Email (Bootstrap initial owner account)
# When a user registers or logs in with this email, they are securely granted the 'admin' role.
ADMIN_EMAIL=owner.admin@gmail.com

# Domain policy: comma-separated list of allowed email domains
# Example: gmail.com,fpt.edu.vn,fe.edu.vn
ALLOWED_EMAIL_DOMAINS=gmail.com,fpt.edu.vn,fe.edu.vn

# Session secret for hashing and signing session tokens
SESSION_SECRET=super-secret-session-key-know-your-strengths-ssb201

# Google OAuth & Supabase Auth Configuration (Optional for cloud provider)
# When present, users can authenticate directly via Google OAuth / Supabase.
# When omitted, the built-in verified email/password flow acts as the secure alternative.
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
